---
import Landing from '../layouts/Landing.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Landing title="Page not found | PgOutput2Json" description="This page doesn't exist.">
  <section class="band">
    <div class="wrap">
      <p class="label">404</p>
      <h1 class="h-section">Page not found</h1>
      <p class="lead">This page doesn't exist, or it moved. The docs start with Getting started.</p>
      <div class="actions">
        <a class="btn btn-solid" href={`${base}docs/getting-started/`}>Getting started</a>
        <a class="btn btn-line" href={base}>Home</a>
      </div>
    </div>
  </section>
</Landing>
