<Project>

    <!--
        Shared build and package metadata for every project under src/.

        Imported before each project body, so everything here is a default:
        a project's own PropertyGroup overrides it (TestWorker relies on that
        to switch ImplicitUsings to enable).

        Deliberately NOT hoisted here:
          TargetFrameworks        Tests and TestWorker declare a single
                                  TargetFramework; setting both properties
                                  on one project breaks the build.
          GeneratePackageOnBuild  TestWorker does not set IsPackable=false,
                                  so it would try to pack and fail on its
                                  missing icon.png.
          Description             differs per package, and it is what readers
                                  of the NuGet page see.
          icon.png / README.md    those item groups only belong to the 12
                                  packable projects where the files exist.
    -->
    <PropertyGroup>
        <Version>2.2.0</Version>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Authors>PgOutput2Json</Authors>
        <Copyright>Copyright (c) 2021 PgOutput2Json</Copyright>
        <RepositoryUrl>https://github.com/PgOutput2Json/PgOutput2Json</RepositoryUrl>
        <PackageProjectUrl>https://pg2json.com/</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <!-- the 12 packages: the projects with an icon.png (not the tests, the benchmark or TestWorker) -->
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/icon.png')">
        <!-- symbols with Source Link (in the SDK): a debugger steps into the source of the commit built -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- deterministic, with the paths normalized: the same commit builds the same assemblies on any machine -->
        <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>

        <!-- each package is compared with a release on nuget.org when it is built, and its target frameworks with each other:
             an API removed or changed, or a target framework dropped, fails the build unless it is listed in the project's
             CompatibilitySuppressions.xml, on purpose. The baseline is the first release of the version line (x.y.0):
             patch releases do not move it -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>2.1.0</PackageValidationBaselineVersion>
    </PropertyGroup>

    <!-- the public API, listed in PublicAPI.Shipped.txt (released) and PublicAPI.Unshipped.txt (since the last release) next to
         each package's project: a change to it fails the build until the lists are updated, so it shows in the pull request -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/icon.png')">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
